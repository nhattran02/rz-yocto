-static void soft_delay(uint64_t usec)
+static uint32_t get_cpu_clock_hz(void)
 {
+	static uint32_t cpuclk_freq = 0;
+#if PLAT_CA55_CLOCKUP
 	/* RZ/G3E: CPU Clock = 1.8G Hz*/
-	const uint32_t cpuclk_freq = 1800000000;
+	cpuclk_freq = 1800000000;
+#else
+	static bool initialized = false;
+	if (initialized) {
+		return cpuclk_freq;
+	}
+	/* CPU Clock is determined by the settings of SYS_LSI_MODE[12:11] (BOOTPLLCA[1:0]) bits
+	 * BOOTPLLCA[1:0] = 00b : 1.1GHz
+	 * BOOTPLLCA[1:0] = 01b : 1.5GHz
+	 * BOOTPLLCA[1:0] = 10b : 1.6GHz
+	 * BOOTPLLCA[1:0] = 11b : 1.7GHz
+	 */
+	const uint32_t cpuclk_table[4] = {
+		1100000000, /* 00b */
+		1500000000, /* 01b */
+		1600000000, /* 10b */
+		1700000000  /* 11b */
+	};
+	uint32_t sys_lsi_mode = mmio_read_32(SYS_LSI_MODE);
+	uint32_t bootpllca = (sys_lsi_mode >> 11) & 0x3;
+	cpuclk_freq = cpuclk_table[bootpllca];
+	initialized = true;
+#endif
+	return cpuclk_freq;
+}
+
+static void __attribute__((optimize("O0"))) soft_delay(uint64_t usec)
+{
+	const uint32_t cpuclk_freq = get_cpu_clock_hz();
 	const uint32_t nop_clk_cycles = 4;
 	const uint32_t num_of_nop_needed = cpuclk_freq / (nop_clk_cycles * 1000000);
 
 	volatile uint64_t timeout = num_of_nop_needed * usec;
 
 	while (timeout--) {
-		__asm__ ("nop");
-		dsb();
+		__asm__ volatile("nop");
 	}
+	dsb();
 }
 
 void wait_dficlk(uint32_t cycles)
