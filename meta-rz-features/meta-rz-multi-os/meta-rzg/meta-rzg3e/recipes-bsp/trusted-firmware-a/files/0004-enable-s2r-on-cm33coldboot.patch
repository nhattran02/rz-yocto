 #include "rz_private.h"
 #include "sys_regs.h"
 
+#if defined(PLAT_SYSTEM_SUSPEND_awo)
+#include "rz_soc_def.h"
+#include <drivers/arm/gic_common.h>
+
+/** GICD_CTLR.EnableGrp* write mask */
+#define GICD_CTLR_EGRP_MASK 0xfffffff8
+/** GICD_CTLR.RWP read mask */
+#define GICD_CTLR_RWP_MASK 0x80000000
+/** ICU_SWINT offset */
+#define ICU_SWINT 0x0130
+/** Software interrupt number to use */
+#define INT_NUM_TO_USE 0
+/** bit shift for CM33 SE_INT */
+#define SHIFT_FOR_IM33 16
+
+static void rz_awo_notify(void)
+{
+		/* NOTICE("rz_awo_notify: Notify CM33 of request for AWO.\n"); */
+		mmio_write_32(RZG3E_ELC + ICU_SWINT, 1 << (INT_NUM_TO_USE + SHIFT_FOR_IM33));
+}
+#endif
 
 extern void pwrc_func_call_with_pmustack(uintptr_t jump, void *arg);
 
@@ -31,7 +52,20 @@ static void __dead2 pwrc_go_suspend_to_ram(void)
 
