+    mmio_write_32(RZ_SOC_GICD_BASE + GICD_CTLR, reg32 & GICD_CTLR_EGRP_MASK);
+    do {
+        reg32 = mmio_read_32(RZ_SOC_GICD_BASE + GICD_CTLR);
+    }while (reg32 & GICD_CTLR_RWP_MASK);
