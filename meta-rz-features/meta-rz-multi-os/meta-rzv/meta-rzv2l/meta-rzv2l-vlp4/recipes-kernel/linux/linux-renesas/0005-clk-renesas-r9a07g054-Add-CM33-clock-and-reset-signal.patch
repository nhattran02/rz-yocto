From d76005a3dc88680aa5fe8ce9806fabac9c687b72 Mon Sep 17 00:00:00 2001
From: Nguyen Thanh Tam <tam.nguyen.wr@renesas.com>
Date: Wed, 3 Dec 2025 17:27:06 +0700
Subject: [PATCH] clk-renesas-r9a07g054-Add-CM33-clock-and-reset-signal

---
 drivers/clk/renesas/r9a07g044-cpg.c       | 13 ++++++++++---
 include/dt-bindings/clock/r9a07g054-cpg.h |  5 +++++
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/renesas/r9a07g044-cpg.c b/drivers/clk/renesas/r9a07g044-cpg.c
index 5edc1cedece1..db1d1db8dbd2 100644
--- a/drivers/clk/renesas/r9a07g044-cpg.c
+++ b/drivers/clk/renesas/r9a07g044-cpg.c
@@ -236,7 +236,7 @@ static const struct {
 };
 
 static const struct {
-	struct rzg2l_mod_clk common[84];
+	struct rzg2l_mod_clk common[86];
 #ifdef CONFIG_CLK_R9A07G054
 	struct rzg2l_mod_clk drp[5];
 #endif
@@ -340,6 +340,10 @@ static const struct {
 					0x56c, 0),
 		DEF_MOD("lcdc_clk_d",	R9A07G044_LCDC_CLK_D, R9A07G044_CLK_M3,
 					0x56c, 1),
+		DEF_MOD("cm33_clkin",   R9A07G054_CM33_CLKIN, R9A07G054_CLK_I2,
+					0x504, 0),
+		DEF_MOD("cm33_tsclk",   R9A07G054_CM33_TSCLK, R9A07G054_OSCCLK,
+					0x504, 1),
 		DEF_MOD("ssi0_pclk",	R9A07G044_SSI0_PCLK2, R9A07G044_CLK_P0,
 					0x570, 0),
 		DEF_MOD("ssi0_sfr",	R9A07G044_SSI0_PCLK_SFR, R9A07G044_CLK_P0,
@@ -496,6 +500,9 @@ static struct rzg2l_reset r9a07g044_resets[] = {
 	DEF_RST(R9A07G044_TSU_PRESETN, 0x8ac, 0),
 #ifdef CONFIG_CLK_R9A07G054
 	DEF_RST(R9A07G054_STPAI_ARESETN, 0x8e8, 0),
+	DEF_RST(R9A07G054_CM33_NPORESET, 0x804, 0),
+	DEF_RST(R9A07G054_CM33_NSYSRESET, 0x804, 1),
+	DEF_RST(R9A07G054_CM33_MISCRESETN, 0x804, 2),
 #endif
 };
 
@@ -556,7 +563,7 @@ const struct rzg2l_cpg_info r9a07g054_cpg_info = {
 	/* Module Clocks */
 	.mod_clks = mod_clks.common,
 	.num_mod_clks = ARRAY_SIZE(mod_clks.common) + ARRAY_SIZE(mod_clks.drp),
-	.num_hw_mod_clks = R9A07G054_STPAI_ACLK_DRP + 1,
+	.num_hw_mod_clks = R9A07G054_CM33_TSCLK + 1,
 
 	/* No PM Module Clocks */
 	.no_pm_mod_clks = r9a07g044_no_pm_mod_clks,
@@ -564,7 +571,7 @@ const struct rzg2l_cpg_info r9a07g054_cpg_info = {
 
 	/* Resets */
 	.resets = r9a07g044_resets,
-	.num_resets = R9A07G054_STPAI_ARESETN + 1, /* Last reset ID + 1 */
+	.num_resets = R9A07G054_CM33_MISCRESETN + 1, /* Last reset ID + 1 */
 
 	.has_clk_mon_regs = true,
 };
diff --git a/include/dt-bindings/clock/r9a07g054-cpg.h b/include/dt-bindings/clock/r9a07g054-cpg.h
index 43f4dbda872c..1c82ea85dd0f 100644
--- a/include/dt-bindings/clock/r9a07g054-cpg.h
+++ b/include/dt-bindings/clock/r9a07g054-cpg.h
@@ -138,6 +138,8 @@
 #define R9A07G054_STPAI_MCLK		99
 #define R9A07G054_STPAI_DCLKIN		100
 #define R9A07G054_STPAI_ACLK_DRP	101
+#define R9A07G054_CM33_CLKIN            102
+#define R9A07G054_CM33_TSCLK            103
 
 /* R9A07G054 Resets */
 #define R9A07G054_CA55_RST_1_0		0
@@ -225,5 +227,8 @@
 #define R9A07G054_ADC_ADRST_N		82
 #define R9A07G054_TSU_PRESETN		83
 #define R9A07G054_STPAI_ARESETN		84
+#define R9A07G054_CM33_NPORESET         85
+#define R9A07G054_CM33_NSYSRESET        86
+#define R9A07G054_CM33_MISCRESETN       87
 
 #endif /* __DT_BINDINGS_CLOCK_R9A07G054_CPG_H__ */
-- 
2.34.1

