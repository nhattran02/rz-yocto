From 5bb7bccc0457b7e24ea5fdb4a3046f9242f817d2 Mon Sep 17 00:00:00 2001
From: Nguyen Thanh Tam <tam.nguyen.wr@renesas.com>
Date: Wed, 3 Dec 2025 16:13:16 +0700
Subject: [PATCH] arm64-dts-renesas-rzv2l-smarc-Add-rproc-node

---
 arch/arm64/boot/dts/renesas/r9a07g054.dtsi    | 21 +++++++++++++++++++
 .../boot/dts/renesas/rzg2l-smarc-som.dtsi     | 18 ++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r9a07g054.dtsi b/arch/arm64/boot/dts/renesas/r9a07g054.dtsi
index b6a4f13b14bc..2f6d1f4820b7 100644
--- a/arch/arm64/boot/dts/renesas/r9a07g054.dtsi
+++ b/arch/arm64/boot/dts/renesas/r9a07g054.dtsi
@@ -1329,6 +1329,27 @@ edac: edac@11410000 {
 			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "ecc_irq";
 		};
+                cm33_rproc: cm33 {
+                        compatible = "renesas,rz-cm33";
+                        reg = <0x0 0x00010000 0x0 0x0000800>,
+                                <0x0 0x0001FF80 0x0 0x0000080>,
+                                <0x0 0x40010000 0x0 0x3EF0000>;
+                        reg-names = "cm33_sram_ns", "cm33_sram_s", "cm33_ddr";
+                        memory-region = <&vdev0vring0>, <&vdev0vring1>, <&vdev0buffer>;
+                        renesas,rz-cpg = <&cpg>;
+                        renesas,rz-sysc = <&sysc>;
+                        renesas,rz-bootaddrs = <0x1001FF80>, <0x00010000>;
+                        renesas,rz-rsctbl = <0x42F00000>;
+                        clocks = <&cpg CPG_MOD R9A07G054_CM33_CLKIN>,
+                                 <&cpg CPG_MOD R9A07G054_CM33_TSCLK>;
+                        clock-names = "clkin", "tsclk";
+                        resets = <&cpg R9A07G054_CM33_NPORESET>,
+                                        <&cpg R9A07G054_CM33_NSYSRESET>,
+                                        <&cpg R9A07G054_CM33_MISCRESETN>;
+                        reset-names = "nporeset", "nsysreset", "miscresetn";
+                        power-domains = <&cpg>;
+                        status = "okay";
+                };
 
 		dmac: dma-controller@11820000 {
 			compatible = "renesas,r9a07g054-dmac",
diff --git a/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi b/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi
index 2294333325b8..a3422c4073d0 100644
--- a/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi
+++ b/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi
@@ -52,6 +52,24 @@ mmp_reserved: linux,multimedia {
 			reusable;
 			reg = <0x0 0x68000000 0x0 0x8000000>;
 		};
+
+                vdev0vring0: vdev0vring0@0x43000000 {
+                        compatible = "shared-dma-pool";
+                        reg = <0x0 0x43000000 0x0 0x50000>;
+                        no-map;
+                };
+
+                vdev0vring1: vdev0vring1@0x43050000 {
+                        compatible = "shared-dma-pool";
+                        reg = <0x0 0x43050000 0x0 0x50000>;
+                        no-map;
+                };
+
+                vdev0buffer: vdev0buffer@0x43200000 {
+                        compatible = "shared-dma-pool";
+                        reg = <0x0 0x43200000 0x0 0x300000>;
+                        no-map;
+                };
 	};
 
 	mmngr {
-- 
2.34.1

