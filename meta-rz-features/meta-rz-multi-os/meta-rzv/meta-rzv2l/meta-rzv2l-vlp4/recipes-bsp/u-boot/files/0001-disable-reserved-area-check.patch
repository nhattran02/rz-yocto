Subject: [PATCH] disable-reserved-area-check

---
 fs/fs.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/fs/fs.c b/fs/fs.c
index acf465bdd8..8e7c8bd443 100644
--- a/fs/fs.c
+++ b/fs/fs.c
@@ -556,8 +556,7 @@ static int fs_read_lmb_check(const char *filename, ulong addr, loff_t offset,
 	if (lmb_alloc_addr(&lmb, addr, read_len) == addr)
 		return 0;
 
-	log_err("** Reading file would overwrite reserved memory **\n");
-	return -ENOSPC;
+	return 0;
 }
 #endif
 
