 $(eval $(call add_define,PLAT_EXTRA_LD_SCRIPT))
 endif
 ifeq (${ENABLE_CM33_FIRMWARE_LOAD}, 1)
+ifeq (${BOOT_TFA_USING_CM33}, 1)
