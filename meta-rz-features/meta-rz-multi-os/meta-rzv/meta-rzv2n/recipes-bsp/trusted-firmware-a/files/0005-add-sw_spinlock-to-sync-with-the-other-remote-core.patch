diff --git a/include/lib/spinlock.h b/include/lib/spinlock.h
index 9fd3fc65f..6d9002304 100644
--- a/include/lib/spinlock.h
+++ b/include/lib/spinlock.h
@@ -18,6 +18,15 @@ typedef struct spinlock {
 void spin_lock(spinlock_t *lock);
 void spin_unlock(spinlock_t *lock);
 
+typedef struct {
+	volatile uint32_t flag_me;	// offset 0
+	volatile uint32_t flag_other;	// offset 4
+	volatile uint32_t turn;		// offset 8
+} sw_spinlock_t;
+
+void sw_spin_lock(sw_spinlock_t *lock);
+void sw_spin_unlock(sw_spinlock_t *lock);
+
 #else
 
 /* Spin lock definitions for use in assembly */
diff --git a/lib/locks/exclusive/aarch64/spinlock.S b/lib/locks/exclusive/aarch64/spinlock.S
index 5144bf7a9..dcd49b925 100644
--- a/lib/locks/exclusive/aarch64/spinlock.S
+++ b/lib/locks/exclusive/aarch64/spinlock.S
@@ -8,6 +8,8 @@
 
 	.globl	spin_lock
 	.globl	spin_unlock
+	.globl	sw_spin_lock
+	.globl	sw_spin_unlock
 
 #if USE_SPINLOCK_CAS
 #if !ARM_ARCH_AT_LEAST(8, 1)
@@ -73,3 +75,50 @@ func spin_unlock
 	stlr	wzr, [x0]
 	ret
 endfunc spin_unlock
+
+/*
+ * Software spinlock implementation for Peterson's algorithm
+ *
+ * The spinlock structure is defined as follows:
+ *
+ * struct sw_spinlock {
+ *     volatile uint32_t flag_me	// offset 0
+ *     volatile uint32_t flag_other;	// offset 4
+ *     volatile uint32_t turn;		// offset 8
+ * };
+ *
+ * The core using this implementation sets flag_me to indicate interest
+ * in acquiring the lock.
+ * The other sets flag_other.
+ * The turn variable indicates whose turn it is to acquire the lock
+ * when both are interested.
+ *
+ * Note: This implementation only works correctly on 2 candidates.
+ *
+ * void sw_spinlock(struct sw_spinlock *lock);
+ * void sw_spinunlock(struct sw_spinlock *lock);
+ */
+func sw_spin_lock
+	mov		w1, #1
+	str		w1, [x0, #0]		/* flag_me = 1 */
+	dmb		ish
+	mov		w1, #1
+	str		w1, [x0, #8]		/* turn = 1 (give other processor priority) */
+	dmb		ish
+1:
+	ldr		w1, [x0, #4]		/* load flag_other */
+	cbz		w1, 2f				/* if the other processor's flag==0, got the lock */
+	ldr		w2, [x0, #8]		/* load turn */
+	cmp		w2, #1
+	b.eq	1b					/* if turn==1 and the other processor wants the lock, spin */
+2:
+	dmb		ish
+	ret
+endfunc sw_spin_lock
+
+func sw_spin_unlock
+	dmb		ish
+	str		wzr, [x0, #0]		/* flag_me = 0 */
+	dmb		ish
+	ret
+endfunc sw_spin_unlock
diff --git a/plat/renesas/rz/soc/v2n/plat_pm.c b/plat/renesas/rz/soc/v2n/plat_pm.c
index 023a7881a..1d9c61fcd 100644
--- a/plat/renesas/rz/soc/v2n/plat_pm.c
+++ b/plat/renesas/rz/soc/v2n/plat_pm.c
@@ -13,6 +13,7 @@
 #include <plat/common/platform.h>
 #include <cpg.h>
 #include <wdt.h>
+#include <lib/spinlock.h>
 
 #include <cpg_regs.h>
 #include <sys_regs.h>
@@ -66,17 +67,27 @@ static void rz_program_trusted_mailbox(u_register_t mpidr, uintptr_t address)
 static void rzv2n_pwr_cpuoff(unsigned long mpidr)
 {
 	uint8_t coreid = MPIDR_AFFLVL1_VAL(mpidr);
+#ifdef BOOT_TFA_USING_CM33
+	/* spin lock shared between CA55 and CM33
+	 * it will use SYS_GPREG_0, SYS_GPREG_1, SYS_GPREG_2 registers to hold the lock struct
+	 */
+	sw_spinlock_t * const shared_lock = (sw_spinlock_t *) SYS_GPREG_0;
+#endif
 
 	if (read_mpidr_el1() != mpidr) {
 		ERROR("RZ/V2N: fail to power-off.\n");
 		panic();
 	}
 
+#ifdef BOOT_TFA_USING_CM33
+	/* Acquire spin lock to sync with CM33 */
+	sw_spin_lock(shared_lock);
+#endif
 	/* Request transition to Cortex-A55 CoreX Sleep Mode */
-	mmio_write_32(CPG_LP_CTL1, (CPG_LP_CTL1_CA55SLEEP_REQ << coreid));
-
-	/* Enter the Cortex-A55 Sleep Mode */
-	mmio_write_32(CPG_LP_CTL1, mmio_read_32(CPG_LP_CTL1) | 0x00000001);
+	mmio_write_32(CPG_LP_CTL1, mmio_read_32(CPG_LP_CTL1) | (CPG_LP_CTL1_CA55SLEEP_REQ << coreid));
+#ifdef BOOT_TFA_USING_CM33
+	sw_spin_unlock(shared_lock);
+#endif
 
 	/* Issue Barrier instruction */
 	isb();
